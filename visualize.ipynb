    "# Cluster sizes\n",
    "k = len(centroids)\n",
    "for c in range(k):\n",
    "    count = np.sum(labels == c)\n",
    "    print(f\"Cluster {c}: {count} points ({100*count/len(labels):.1f}%)\")"
